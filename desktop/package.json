{
  "name": "minierp-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Masaüstü Yönetim ve Finans (Mini-ERP)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --dir",
    "api:win": "dotnet publish ../backend/src/MiniErp.Api/MiniErp.Api.csproj -c Release --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:DebugType=none -p:GenerateDocumentationFile=false -r win-x64 -o ../backend/publish/win-x64",
    "api:mac": "dotnet publish ../backend/src/MiniErp.Api/MiniErp.Api.csproj -c Release --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:DebugType=none -p:GenerateDocumentationFile=false -r osx-arm64 -o ../backend/publish/osx-arm64",
    "dist:demo:win": "npm run build && npm run api:win && cross-env DEMO_RID=win-x64 electron-builder --win --config electron-builder.demo.cjs",
    "dist:demo:mac": "npm run build && npm run api:mac && cross-env DEMO_RID=osx-arm64 electron-builder --mac --config electron-builder.demo.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.0"
  },
  "author": {
    "name": "Mini-ERP"
  },
  "build": {
    "appId": "com.minierp.desktop",
    "productName": "Mini-ERP",
    "copyright": "© 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mini-ERP"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://GUNCELLEME-SUNUCUSU/minierp/"
      }
    ]
  }
}
